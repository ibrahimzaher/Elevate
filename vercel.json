{
  "version": 2,
  "buildCommand": "npx ng build E-commerce",
  "installCommand": "npm install --legacy-peer-deps",
  "outputDirectory": "dist/apps/E-commerce/browser",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "images": {
    "sizes": [256, 384, 640, 750, 828, 1080, 1200, 1920, 2048, 3840],
    "formats": ["image/avif", "image/webp"],
    "remotePatterns": [
      {
        "protocol": "https",
        "hostname": "**"
      }
    ]
  }
}
